#!/opt/base/bin/python
import argparse
import atexit
import os
import shlex
import signal
import socket
import subprocess
import sys
import threading
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Optional


def _env_int(name: str, default: int, minimum: int = 1) -> int:
    raw = os.getenv(name)
    if raw is None or raw == "":
        return default
    try:
        value = int(raw)
    except ValueError:
        return default
    return max(value, minimum)


@dataclass
class LockConfig:
    poll_ms: int = _env_int("GPU_BENCH_LOCK_POLL_MS", 200)
    timeout_s: int = _env_int("GPU_BENCH_LOCK_TIMEOUT_S", 300)
    grace_age_s: int = _env_int("GPU_BENCH_LOCK_GRACE_AGE_S", 180)
    heartbeat_s: int = _env_int("GPU_BENCH_LOCK_HEARTBEAT_S", 2)
    orphan_check_s: int = _env_int("GPU_BENCH_LOCK_ORPHAN_CHECK_S", 5)
    orphan_empty_threshold: int = _env_int("GPU_BENCH_LOCK_ORPHAN_EMPTY_THRESHOLD", 6)


def _normalize_uuid(u: str) -> str:
    s = u.strip().lower()
    if s.startswith("gpu-"):
        s = s[4:]
    return s


def _run_cmd(cmd: list[str]) -> tuple[bool, str]:
    try:
        result = subprocess.run(cmd, check=False, capture_output=True, text=True)
    except FileNotFoundError:
        return (False, "")
    return (result.returncode == 0, result.stdout)


def _gpu_uuid_by_index(index: int) -> Optional[str]:
    ok, out = _run_cmd(["nvidia-smi", "--query-gpu=index,uuid", "--format=csv,noheader,nounits"])
    if not ok or not out:
        return None
    for line in out.splitlines():
        parts = [x.strip() for x in line.split(",")]
        if len(parts) < 2:
            continue
        try:
            idx = int(parts[0])
        except ValueError:
            continue
        if idx == index:
            return _normalize_uuid(parts[1])
    return None


def _gpu_has_processes_by_index(index: int) -> bool:
    target_uuid = _gpu_uuid_by_index(index)
    if target_uuid is None:
        # Fail-safe: if cannot query GPU mapping, never auto-delete existing lock.
        return True
    ok, out = _run_cmd(["nvidia-smi", "--query-compute-apps=gpu_uuid,pid", "--format=csv,noheader,nounits"])
    if not ok:
        return True
    if out.strip() == "":
        return False
    for line in out.splitlines():
        parts = [x.strip() for x in line.split(",")]
        if len(parts) < 2:
            continue
        if _normalize_uuid(parts[0]) != target_uuid:
            continue
        try:
            pid = int(parts[1])
        except ValueError:
            continue
        if pid > 0:
            return True
    return False


def resolve_lock_root() -> Path:
    env_root = os.getenv("GPU_BENCH_LOCK_DIR", "").strip()
    if env_root:
        path = Path(env_root)
        path.mkdir(mode=0o700, parents=True, exist_ok=True)
        try:
            os.chmod(path, 0o700)
        except PermissionError:
            pass
        return path

    default_root = Path("/var/lock/gpu-benchmark")
    try:
        default_root.mkdir(mode=0o700, parents=True, exist_ok=True)
        try:
            os.chmod(default_root, 0o700)
        except PermissionError:
            pass
        return default_root
    except Exception:
        fallback_root = Path("/tmp/gpu_benchmark_locks")
        fallback_root.mkdir(mode=0o700, parents=True, exist_ok=True)
        try:
            os.chmod(fallback_root, 0o700)
        except PermissionError:
            pass
        return fallback_root


def _read_last_heartbeat_ms(lock_path: Path) -> int:
    try:
        data = lock_path.read_text(encoding="utf-8", errors="ignore")
    except Exception:
        return -1
    for line in data.splitlines():
        if line.startswith("last_heartbeat_ms="):
            try:
                return int(line.split("=", 1)[1].strip())
            except ValueError:
                return -1
    return -1


class GpuBenchLock:
    def __init__(self, physical_device_id: int, config: Optional[LockConfig] = None):
        self.physical_device_id = int(physical_device_id)
        self.config = config or LockConfig()
        self.root = resolve_lock_root()
        self.lock_path = self.root / f"gpu{self.physical_device_id}.lock"
        self.fd: Optional[int] = None
        self.start_time = time.time()
        self._stop = threading.Event()
        self._heartbeat_thread: Optional[threading.Thread] = None
        self._old_handlers: dict[int, signal.Handlers] = {}
        self._registered_atexit = False
        self._orphan_last_probe = 0.0
        self._orphan_last_mtime_ns = -1
        self._orphan_last_hb = -1
        self._orphan_empty_count = 0

    def _lock_payload(self, now_ms: int) -> str:
        cmdline = " ".join(shlex.quote(x) for x in sys.argv)
        return (
            f"pid={os.getpid()}\n"
            f"hostname={socket.gethostname()}\n"
            f"device_id={self.physical_device_id}\n"
            f"start_time={self.start_time:.3f}\n"
            f"cmdline={cmdline}\n"
            f"last_heartbeat_ms={now_ms}\n"
        )

    def _write_heartbeat(self) -> None:
        if self.fd is None:
            return
        payload = self._lock_payload(int(time.time() * 1000)).encode("utf-8")
        os.ftruncate(self.fd, 0)
        os.lseek(self.fd, 0, os.SEEK_SET)
        os.write(self.fd, payload)
        os.fsync(self.fd)

    def _start_heartbeat(self) -> None:
        interval = min(max(self.config.heartbeat_s, 1), 2)

        def _loop() -> None:
            while not self._stop.wait(interval):
                try:
                    self._write_heartbeat()
                except Exception:
                    return

        self._heartbeat_thread = threading.Thread(target=_loop, name="gpu-bench-lock-heartbeat", daemon=True)
        self._heartbeat_thread.start()

    def _register_signal_cleanup(self) -> None:
        def _handler(signum, _frame):
            self.release()
            os._exit(128 + signum)

        for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT):
            self._old_handlers[sig] = signal.getsignal(sig)
            signal.signal(sig, _handler)

        if not self._registered_atexit:
            atexit.register(self.release)
            self._registered_atexit = True

    def _restore_signal_handlers(self) -> None:
        for sig, old in self._old_handlers.items():
            try:
                signal.signal(sig, old)
            except Exception:
                pass
        self._old_handlers.clear()

    def _maybe_cleanup_orphan_lock(self) -> None:
        try:
            st = self.lock_path.stat()
        except FileNotFoundError:
            self._orphan_empty_count = 0
            self._orphan_last_mtime_ns = -1
            self._orphan_last_hb = -1
            return

        now = time.time()
        age_s = now - st.st_mtime
        if age_s <= self.config.grace_age_s:
            # Fresh lock: always wait, never reclaim.
            self._orphan_empty_count = 0
            self._orphan_last_mtime_ns = -1
            self._orphan_last_hb = -1
            return

        if now - self._orphan_last_probe < self.config.orphan_check_s:
            return
        self._orphan_last_probe = now

        if _gpu_has_processes_by_index(self.physical_device_id):
            self._orphan_empty_count = 0
            self._orphan_last_mtime_ns = -1
            self._orphan_last_hb = -1
            return

        hb = _read_last_heartbeat_ms(self.lock_path)
        mtime_ns = st.st_mtime_ns

        if hb == self._orphan_last_hb and mtime_ns == self._orphan_last_mtime_ns:
            self._orphan_empty_count += 1
        else:
            self._orphan_empty_count = 1
            self._orphan_last_hb = hb
            self._orphan_last_mtime_ns = mtime_ns

        if self._orphan_empty_count >= self.config.orphan_empty_threshold and age_s > self.config.grace_age_s:
            try:
                st2 = self.lock_path.stat()
            except FileNotFoundError:
                self._orphan_empty_count = 0
                self._orphan_last_mtime_ns = -1
                self._orphan_last_hb = -1
                return
            hb2 = _read_last_heartbeat_ms(self.lock_path)
            age2 = time.time() - st2.st_mtime
            if (
                age2 > self.config.grace_age_s
                and hb2 == self._orphan_last_hb
                and st2.st_mtime_ns == self._orphan_last_mtime_ns
                and not _gpu_has_processes_by_index(self.physical_device_id)
            ):
                try:
                    self.lock_path.unlink()
                except FileNotFoundError:
                    pass
            self._orphan_empty_count = 0
            self._orphan_last_mtime_ns = -1
            self._orphan_last_hb = -1

    def acquire(self) -> None:
        deadline = time.monotonic() + self.config.timeout_s
        while True:
            try:
                self.fd = os.open(
                    self.lock_path,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                    0o600,
                )
                self._write_heartbeat()
                self._start_heartbeat()
                self._register_signal_cleanup()
                return
            except FileExistsError:
                self._maybe_cleanup_orphan_lock()
                if time.monotonic() > deadline:
                    raise TimeoutError(
                        f"Timeout while waiting for GPU benchmark lock: {self.lock_path} (>{self.config.timeout_s}s)"
                    )
                time.sleep(max(self.config.poll_ms, 1) / 1000.0)

    def release(self) -> None:
        if self.fd is None:
            return
        self._stop.set()
        if self._heartbeat_thread is not None:
            self._heartbeat_thread.join(timeout=3.0)
        try:
            os.close(self.fd)
        except Exception:
            pass
        self.fd = None
        try:
            self.lock_path.unlink()
        except FileNotFoundError:
            pass
        self._restore_signal_handlers()

    def __enter__(self) -> "GpuBenchLock":
        self.acquire()
        return self

    def __exit__(self, exc_type, exc, tb) -> None:
        self.release()


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="gpulock",
        description="GPU benchmark lock wrapper: gpulock <gpu_id> \"<command>\"",
    )
    parser.add_argument("gpu_id", type=int, help="Physical GPU index to lock (nvidia-smi index).")
    parser.add_argument(
        "command",
        nargs=argparse.REMAINDER,
        help="Command to run. Examples: gpulock 1 \"python bench.py --device 1\" or gpulock 1 -- python bench.py --device 1",
    )
    parser.add_argument("--poll-ms", type=int, default=LockConfig.poll_ms)
    parser.add_argument("--timeout-s", type=int, default=LockConfig.timeout_s)
    parser.add_argument("--grace-age-s", type=int, default=LockConfig.grace_age_s)
    parser.add_argument("--heartbeat-s", type=int, default=LockConfig.heartbeat_s)
    parser.add_argument("--orphan-check-s", type=int, default=LockConfig.orphan_check_s)
    parser.add_argument("--orphan-empty-threshold", type=int, default=LockConfig.orphan_empty_threshold)
    parser.add_argument(
        "--set-cuda-visible-devices",
        action="store_true",
        help="Export CUDA_VISIBLE_DEVICES=<gpu_id> for the child command.",
    )
    return parser


def _normalize_command(raw: list[str]) -> tuple[str, bool]:
    if not raw:
        raise ValueError("Missing command. Usage: gpulock <gpu_id> \"<cmd>\" or gpulock <gpu_id> -- <cmd> [args...]")
    if raw[0] == "--":
        raw = raw[1:]
        if not raw:
            raise ValueError("Missing command after '--'.")
    if len(raw) == 1:
        return (raw[0], True)
    return (" ".join(shlex.quote(x) for x in raw), True)


def main() -> int:
    parser = _build_parser()
    args = parser.parse_args()

    cfg = LockConfig(
        poll_ms=max(args.poll_ms, 1),
        timeout_s=max(args.timeout_s, 1),
        grace_age_s=max(args.grace_age_s, 1),
        heartbeat_s=max(args.heartbeat_s, 1),
        orphan_check_s=max(args.orphan_check_s, 1),
        orphan_empty_threshold=max(args.orphan_empty_threshold, 1),
    )
    command, shell_mode = _normalize_command(args.command)

    lock = GpuBenchLock(args.gpu_id, config=cfg)
    try:
        lock.acquire()
    except TimeoutError as e:
        print(f"[GPU Lock] timeout: {e}", file=sys.stderr)
        return 124
    except Exception as e:
        print(f"[GPU Lock] acquire failed: {e}", file=sys.stderr)
        return 1

    print(f"[GPU Lock] acquired device={lock.physical_device_id} lock_path={lock.lock_path}")

    child_env = os.environ.copy()
    child_env["GPU_BENCH_LOCKED_DEVICE"] = str(lock.physical_device_id)
    if args.set_cuda_visible_devices:
        child_env["CUDA_VISIBLE_DEVICES"] = str(lock.physical_device_id)

    try:
        rc = subprocess.run(command, shell=shell_mode, executable="/bin/bash", env=child_env).returncode
    except KeyboardInterrupt:
        rc = 130
    finally:
        lock.release()
        print(f"[GPU Lock] released device={lock.physical_device_id} lock_path={lock.lock_path}")

    return int(rc)


if __name__ == "__main__":
    raise SystemExit(main())
